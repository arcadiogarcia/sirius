<Project>
  <!--
    Shared build properties for every project in the Sirius Updater
    solution. Centralising language version, nullability, packaging
    metadata, and analyzer flags here keeps individual csproj files
    short and consistent.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- NuGet packaging defaults (overridable per-project). -->
    <Authors>Sirius Updater contributors</Authors>
    <Company>Sirius Updater</Company>
    <Product>Sirius Updater</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/arcadiogarcia/sirius</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Version handling uses the built-in VersionPrefix + VersionSuffix
         pair. VersionPrefix must be strict MAJOR.MINOR.BUILD and is the
         only source of AssemblyVersion / FileVersion. VersionSuffix
         carries any prerelease tag (e.g. "rc.1") and only affects the
         NuGet PackageVersion / InformationalVersion. CI passes
         -p:VersionPrefix=… -p:VersionSuffix=… as appropriate. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests/sample don't need the readme; library projects opt in by
         declaring their own <ItemGroup> that picks the root README. -->
  </ItemGroup>
</Project>
